{
  "name": "Linklist Desktop App",
  "version": "1.0.0",
  "description": "A modern smart link management desktop application that helps users save, organize, export, and manage their links efficiently.",
  
  "developer": {
    "name": "Ssekabira Robert",
    "location": "Kampala, Uganda",
    "role": "Software Engineer"
  },

  "technologies": {
    "frontend": ["HTML", "CSS", "JavaScript", "React (optional UI layer)"],
    "backend": ["Node.js", "Express (optional for API style)"],
    "desktop_framework": "Electron",
    "database": "SQLite (via better-sqlite3 or knex)",
    "build_tools": ["Electron Builder", "TypeScript"]
  },

  "features": {
    "link_management": {
      "save_links": true,
      "tagging": true,
      "collections": true,
      "trash_and_restore": true,
      "search": true
    },
    "exporting": {
      "export_to_txt": true,
      "export_to_json": true,
      "export_to_pdf": true
    },
    "backup": {
      "auto_backup": false,
      "manual_backup": true,
      "export_database": true
    },
    "appearance": {
      "theme_mode": ["dark", "light"],
      "splash_screen": true
    }
  },

  "splash_information": {
    "title_text": "Welcome to Linklist!",
    "subtitle_text": "Smart link management made simple.",
    "version_display": true,
    "loading_indicator": "animated dots",
    "show_app_logo": true,
    "duration_seconds": 3.5
  },

  "security": {
    "data_storage": "Stored locally inside userData folder",
    "encryption": false,
    "sandboxing": true,
    "contextIsolation": true
  },

  "file_paths": {
    "user_data": "app.getPath('userData')",
    "database": "userData/linklist.db",
    "exports": "user's Desktop",
    "logs": "userData/logs"
  },

  "logging": {
    "enabled": true,
    "framework": "electron-log",
    "logs_stored_in": "userData/logs/app.log"
  },

  "permissions": {
    "filesystem_access": true,
    "internet_access": false,
    "notifications": false,
    "clipboard": true
  },

  "platform_support": {
    "windows": "fully supported",
    "macOS": "supported",
    "linux": "supported"
  },

  "developer_mode": {
    "auto_reload": true,
    "debug_console": true,
    "sourcemaps": true
  },

  "legal": {
    "license": "MIT",
    "author_copyright": "© 2025 Robert Ssekabira",
    "privacy_policy": "Linklist does not send any user data to external servers."
  }
}
