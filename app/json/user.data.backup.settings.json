{
  "backup": {
    "enabled": true,
    "types": {
      "application": {
        "enabled": true,
        "path": "appData/Linklist/Backups/Application",
        "fileNameFormat": "{uuid}-{date}",
        "include": ["application.json"],
        "description": "Backup for application-level configuration files."
      },
      "userData": {
        "enabled": true,
        "path": "appData/Linklist/Backups/Data",
        "fileNameFormat": "{uuid}-{date}",
        "include": [
          "saved_links.json",
          "collections.json",
          "archived_links.json"
        ],
        "description": "Backup for all user-generated data."
      },
      "external": {
        "enabled": false,
        "path": "desktop/Backups/Data",
        "fileNameFormat": "{uuid}-{date}",
        "description": "Optional exported backups to Desktop or removable drives."
      }
    },

    "schedule": {
      "autoBackup": false,
      "frequency": "daily",
      "time": "02:00",
      "daysOfWeek": ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
    },

    "retention": {
      "maxBackups": 10,
      "deleteOldest": true,
      "keepForDays": 30
    },

    "notifications": {
      "onSuccess": true,
      "onFailure": true,
      "showSystemNotification": true
    },

    "compression": {
      "enabled": true,
      "format": "zip",
      "level": 6
    },

    "integrityCheck": {
      "enabled": true,
      "verifyHash": true,
      "hashAlgorithm": "sha256"
    }
  }
}
