{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "rootDir": "./",
    "outDir": "../dist/app",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "electron"]
  },
  "include": ["./**/*.ts", "./**/*.json"],
   "exclude": [
  "node_modules",
  "../frontend",
  "../backend",
  "../dist"
]

}